# Copy to .env and fill in. .env is gitignored and read by both the backend and the Android build.

# Backend (python -m venus_lens). Real environment variables win over this file.
DEEPINFRA_API_KEY=
# Shared secret the phone sends as X-API-Key, e.g. `openssl rand -hex 24`.
VENUS_LENS_TOKEN=
VENUS_LENS_HOST=0.0.0.0
VENUS_LENS_PORT=8765

# Optional backend overrides
# VENUS_LENS_MODEL_FAST=Qwen/Qwen3.5-9B
# VENUS_LENS_MODEL_CAREFUL=google/gemini-3.1-flash-lite
# VENUS_LENS_MODEL_STT=openai/whisper-large-v3-turbo
# VENUS_LENS_MAX_IMAGE_SIDE=1280
# VENUS_LENS_DATA_DIR=~/.local/share/venus-lens
# Daily Markdown journal (on by default): folder and on/off switch
# VENUS_LENS_JOURNAL_DIR=~/Obsidian/Venus
# VENUS_LENS_JOURNAL=1

# Android build: default server URL baked into the APK (still editable in Ajustes).
# Use an address the phone can reach, e.g. the server's LAN or Tailscale IP.
VENUS_LENS_URL=ws://192.168.0.10:8765/v1/ws
