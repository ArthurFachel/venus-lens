<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/icon_btn"
            android:contentDescription="Voltar para ajustes"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/cream" />

        <TextView
            style="@style/T.Black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Depuração"
            android:textColor="@color/cream"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_surface16" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/statFrames" style="@style/T.Black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cream" android:textSize="18sp" />
                <TextView style="@style/T.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="frames enviados" android:textColor="@color/cream_74" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_surface16" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/statLatency" style="@style/T.Black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="— ms" android:textColor="@color/cream" android:textSize="18sp" />
                <TextView style="@style/T.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="tempo de resposta" android:textColor="@color/cream_74" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_surface16" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/statQueue" style="@style/T.Black" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/cream" android:textSize="18sp" />
                <TextView style="@style/T.Bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="fila de envio" android:textColor="@color/cream_74" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Overline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="ÚLTIMA REQUISIÇÃO"
                    android:textColor="#D1FFFFFF" />

                <TextView
                    android:id="@+id/copyReq"
                    style="@style/T.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/btn_outline14"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="copiar"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/lastReq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.3"
                    android:text="(nenhuma ainda)"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_surface18"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView style="@style/Overline" android:text="LOG DA SESSÃO" />

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
